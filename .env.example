# Optional. Without BOTH values the guide uses local retrieval, with no API call.
# Choose a Responses-compatible text model available to your OpenAI project.
OPENAI_API_KEY=
OPENAI_MODEL=
# Used by the production Node server, which binds only to 127.0.0.1.
PORT=4173
# Hosted deployments only (Vercel): comma-separated hostnames allowed to call the guide.
# Unset means any Host, still same-origin only.
ASSISTANT_ALLOWED_HOSTS=
